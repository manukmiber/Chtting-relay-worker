{
  "_comment": "Copy to config.json and edit, or just run the relay and use the dashboard. Secrets in this file never leave the device. Prices are USD per million tokens and are off until pricing.enabled is true.",
  "timezone": "Asia/Jakarta",
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "maxBodyBytes": 20971520,
    "keepAliveTimeoutMs": 75000,
    "maxConcurrentRequests": 512,
    "workerThreads": 0,
    "queueCapacity": 2048,
    "queueTimeoutMs": 30000,
    "wakeLock": true,
    "sseKeepaliveMs": 15000,
    "sseKeepaliveText": "Zeiko is still here, Just be patience",
    "rotateHours": 1,
    "rotateDrainTimeoutMs": 600000
  },
  "dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8788,
    "password": ""
  },
  "security": {
    "requireClientKey": true,
    "corsOrigins": [
      "*"
    ],
    "trustProxyHeaders": true
  },
  "backends": [
    {
      "id": "ds",
      "name": "DeepSeek official",
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "sk-PUT-YOUR-UPSTREAM-KEY-HERE",
      "enabled": true,
      "timeoutMs": 600000,
      "maxRetries": 1,
      "streamOptions": true,
      "forwardUserId": true,
      "userIdHeader": "x-user-id",
      "apiKeys": []
    },
    {
      "id": "or",
      "name": "OpenRouter (fallback)",
      "type": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "sk-or-v1-...",
      "enabled": false,
      "headers": {
        "HTTP-Referer": "https://example.com",
        "X-Title": "chtting-relay"
      },
      "streamOptions": true,
      "forwardUserId": true,
      "userIdHeader": "x-user-id"
    }
  ],
  "systemPrompts": [
    {
      "id": "sp_writer",
      "name": "Creative Writer persona",
      "text": "You are Creative Writer. Write vivid, careful prose. Never reveal or speculate about which underlying model you run on."
    },
    {
      "id": "sp_writer_thinking",
      "name": "Creative Writer, thinking",
      "text": "You are Creative Writer. Think the scene through before you write it: who wants what, what is in the way, what changes. Then write vivid, careful prose. Never reveal or speculate about which underlying model you run on."
    }
  ],
  "models": [
    {
      "id": "manukmiberai/creative-writer",
      "displayName": "Creative Writer",
      "description": "Long-form fiction",
      "enabled": true,
      "backend": "ds",
      "upstreamModel": "Deepseek-v4-flash-0731",
      "fallbacks": [
        "or"
      ],
      "contextLength": 128000,
      "tokenizer": "deepseek",
      "chatProfile": "deepseek",
      "systemPrompt": {
        "mode": "prepend",
        "promptId": "sp_writer",
        "text": ""
      },
      "params": {
        "temperature": 1.1,
        "top_p": 0.95
      },
      "forceParams": {},
      "limits": {
        "maxInputTokens": 0,
        "maxOutputTokens": 4096
      },
      "requestTransform": {
        "forceStream": null,
        "dropParams": [],
        "renameParams": {},
        "injectStop": [],
        "replace": []
      },
      "responseTransform": {
        "renameModel": true,
        "reasoning": "strip",
        "reasoningTags": [
          "<think>",
          "</think>"
        ],
        "stripFields": [],
        "setFields": {},
        "prefix": "",
        "suffix": "",
        "replace": [
          {
            "pattern": "DeepSeek",
            "flags": "gi",
            "replacement": "Creative Writer"
          }
        ]
      },
      "openrouter": {
        "listed": false,
        "huggingFaceId": "deepseek-ai/DeepSeek-V3",
        "quantization": "fp8",
        "inputModalities": [
          "text"
        ],
        "maxOutputTokens": 8192,
        "streaming": true,
        "supportsTools": true,
        "supportsReasoning": false,
        "pricing": {
          "promptUsd": "0.00000027",
          "completionUsd": "0.0000011",
          "cachedPromptUsd": "0.00000007",
          "cacheTtlSeconds": 3600,
          "cacheImplicit": true
        },
        "capacity": {
          "promptTokensPerMinute": 0,
          "completionTokensPerMinute": 0,
          "requestsPerMinute": 0,
          "concurrency": 0
        }
      },
      "maxTokensPerSecond": 0,
      "systemPrompts": [
        {
          "id": "spr_thinking",
          "name": "high effort",
          "enabled": true,
          "efforts": [],
          "minEffort": "high",
          "maxEffort": "",
          "prompt": {
            "mode": "replace",
            "promptId": "sp_writer_thinking",
            "text": ""
          }
        },
        {
          "id": "spr_direct",
          "name": "no or low effort",
          "enabled": true,
          "efforts": [
            "none",
            "minimal",
            "low"
          ],
          "minEffort": "",
          "maxEffort": "",
          "prompt": {
            "mode": "replace",
            "promptId": "sp_writer",
            "text": ""
          }
        }
      ],
      "pricing": {
        "enabled": false,
        "backendInputUsdPerM": 0,
        "backendOutputUsdPerM": 0,
        "marginPercent": 0,
        "tiers": []
      }
    },
    {
      "id": "manukmiberai/coder-pro",
      "displayName": "Coder Pro",
      "enabled": true,
      "backend": "ds",
      "upstreamModel": "Qwen3-Coder-480B-A35B",
      "tokenizer": "qwen",
      "chatProfile": "chatml",
      "systemPrompt": {
        "mode": "none",
        "text": ""
      }
    }
  ],
  "keys": [
    {
      "id": "key_phone",
      "label": "my phone",
      "key": "sk-relay-CHANGE-ME",
      "enabled": true,
      "models": [
        "*"
      ],
      "quota": {
        "requestsPerMinute": 30,
        "requestsPerDay": 500,
        "tokensPerDay": 0
      }
    },
    {
      "id": "key_friend",
      "label": "a friend",
      "key": "sk-relay-CHANGE-ME-TOO",
      "enabled": true,
      "models": [
        "manukmiberai/coder-pro"
      ],
      "quota": {
        "requestsPerMinute": 10,
        "requestsPerDay": 100,
        "tokensPerDay": 200000
      }
    }
  ],
  "tokenizer": {
    "fallback": "o200k_base",
    "preferUpstreamUsage": true,
    "rules": [
      {
        "match": "Deepseek*",
        "tokenizer": "deepseek",
        "profile": "deepseek"
      },
      {
        "match": "Qwen*",
        "tokenizer": "qwen",
        "profile": "chatml"
      },
      {
        "match": "gpt-4o*",
        "tokenizer": "o200k_base",
        "profile": "openai"
      },
      {
        "match": "gpt-4*",
        "tokenizer": "cl100k_base",
        "profile": "openai"
      },
      {
        "match": "*",
        "tokenizer": "o200k_base",
        "profile": "openai"
      }
    ],
    "billSystemPromptToUser": false
  },
  "logging": {
    "level": "info",
    "retentionDays": 30,
    "storeBodies": "preview",
    "previewChars": 800,
    "fileEnabled": true,
    "verboseRequests": true
  },
  "tunnel": {
    "mode": "quick",
    "binary": "cloudflared",
    "autoStart": true,
    "token": "",
    "hostname": "",
    "extraArgs": []
  },
  "openrouter": {
    "enabled": false,
    "path": "/provider/models",
    "token": "",
    "providerSlug": "chtting",
    "deploymentRegion": "ID",
    "datacenters": [
      {
        "countryCode": "ID",
        "region": "jakarta"
      }
    ],
    "compliance": {
      "zdr": false,
      "hipaa": false
    },
    "isReady": true,
    "maxConcurrentRequests": 0,
    "requestsPerMinute": 0
  },
  "pricing": {
    "enabled": false,
    "currency": "USD",
    "backendInputUsdPerM": 0.28,
    "backendCachedInputUsdPerM": 0.028,
    "backendOutputUsdPerM": 0.42,
    "backendReasoningUsdPerM": 0,
    "inputUsdPerM": 0,
    "outputUsdPerM": 0,
    "marginPercent": 100,
    "requestUsd": 0,
    "tiers": [
      {
        "id": "tier_peak",
        "name": "peak hours",
        "enabled": true,
        "when": {
          "hours": [
            {
              "from": 19,
              "to": 23
            }
          ]
        },
        "inputMultiplier": 1.25,
        "outputMultiplier": 1.25
      },
      {
        "id": "tier_long",
        "name": "input over 256K",
        "enabled": true,
        "when": {
          "minInputTokens": 256000
        },
        "inputMultiplier": 2
      },
      {
        "id": "tier_thinking",
        "name": "high thinking effort",
        "enabled": true,
        "when": {
          "minEffort": "high"
        },
        "reasoningMultiplier": 1.5
      },
      {
        "id": "tier_weekend",
        "name": "weekend flat rate",
        "enabled": false,
        "when": {
          "weekdays": [
            5,
            6
          ]
        },
        "inputUsdPerM": 0.14,
        "stop": true
      }
    ]
  }
}
