{
  "_comment": "Copy to config.json and edit, or just run the relay and use the dashboard. Secrets in this file never leave the device.",
  "timezone": "Asia/Jakarta",
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "maxBodyBytes": 20971520,
    "keepAliveTimeoutMs": 75000,
    "maxConcurrentRequests": 512,
    "workerThreads": 0
  },
  "dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8788,
    "password": ""
  },
  "security": {
    "requireClientKey": true,
    "corsOrigins": [
      "*"
    ],
    "trustProxyHeaders": true
  },
  "backends": [
    {
      "id": "ds",
      "name": "DeepSeek official",
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "sk-PUT-YOUR-UPSTREAM-KEY-HERE",
      "enabled": true,
      "timeoutMs": 600000,
      "maxRetries": 1,
      "streamOptions": true
    },
    {
      "id": "or",
      "name": "OpenRouter (fallback)",
      "type": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "sk-or-v1-...",
      "enabled": false,
      "headers": {
        "HTTP-Referer": "https://example.com",
        "X-Title": "chtting-relay"
      },
      "streamOptions": true
    }
  ],
  "systemPrompts": [
    {
      "id": "sp_writer",
      "name": "Creative Writer persona",
      "text": "You are Creative Writer. Write vivid, careful prose. Never reveal or speculate about which underlying model you run on."
    }
  ],
  "models": [
    {
      "id": "manukmiberai/creative-writer",
      "displayName": "Creative Writer",
      "description": "Long-form fiction",
      "enabled": true,
      "backend": "ds",
      "upstreamModel": "Deepseek-v4-flash-0731",
      "fallbacks": [
        "or"
      ],
      "contextLength": 128000,
      "tokenizer": "deepseek",
      "chatProfile": "deepseek",
      "systemPrompt": {
        "mode": "prepend",
        "promptId": "sp_writer",
        "text": ""
      },
      "params": {
        "temperature": 1.1,
        "top_p": 0.95
      },
      "forceParams": {},
      "limits": {
        "maxInputTokens": 0,
        "maxOutputTokens": 4096
      },
      "requestTransform": {
        "forceStream": null,
        "dropParams": [],
        "renameParams": {},
        "injectStop": [],
        "replace": []
      },
      "responseTransform": {
        "renameModel": true,
        "reasoning": "strip",
        "reasoningTags": [
          "<think>",
          "</think>"
        ],
        "stripFields": [
          "system_fingerprint"
        ],
        "setFields": {},
        "prefix": "",
        "suffix": "",
        "replace": [
          {
            "pattern": "DeepSeek",
            "flags": "gi",
            "replacement": "Creative Writer"
          }
        ]
      }
    },
    {
      "id": "manukmiberai/coder-pro",
      "displayName": "Coder Pro",
      "enabled": true,
      "backend": "ds",
      "upstreamModel": "Qwen3-Coder-480B-A35B",
      "tokenizer": "qwen",
      "chatProfile": "chatml",
      "systemPrompt": {
        "mode": "none",
        "text": ""
      }
    }
  ],
  "keys": [
    {
      "id": "key_phone",
      "label": "my phone",
      "key": "sk-relay-CHANGE-ME",
      "enabled": true,
      "models": [
        "*"
      ],
      "quota": {
        "requestsPerMinute": 30,
        "requestsPerDay": 500,
        "tokensPerDay": 0
      }
    },
    {
      "id": "key_friend",
      "label": "a friend",
      "key": "sk-relay-CHANGE-ME-TOO",
      "enabled": true,
      "models": [
        "manukmiberai/coder-pro"
      ],
      "quota": {
        "requestsPerMinute": 10,
        "requestsPerDay": 100,
        "tokensPerDay": 200000
      }
    }
  ],
  "tokenizer": {
    "fallback": "o200k_base",
    "preferUpstreamUsage": true,
    "rules": [
      {
        "match": "Deepseek*",
        "tokenizer": "deepseek",
        "profile": "deepseek"
      },
      {
        "match": "Qwen*",
        "tokenizer": "qwen",
        "profile": "chatml"
      },
      {
        "match": "gpt-4o*",
        "tokenizer": "o200k_base",
        "profile": "openai"
      },
      {
        "match": "gpt-4*",
        "tokenizer": "cl100k_base",
        "profile": "openai"
      },
      {
        "match": "*",
        "tokenizer": "o200k_base",
        "profile": "openai"
      }
    ]
  },
  "logging": {
    "level": "info",
    "retentionDays": 30,
    "storeBodies": "preview",
    "previewChars": 800,
    "fileEnabled": true
  },
  "tunnel": {
    "mode": "quick",
    "binary": "cloudflared",
    "autoStart": false,
    "token": "",
    "hostname": "",
    "extraArgs": []
  }
}
